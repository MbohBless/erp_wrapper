# Copy to .env and adjust. Compose reads this automatically.

# ============================================================================
# Deployment mode
# ============================================================================
# TENANCY_MODE selects which product this stack is:
#
#   single  Self-hosted / dedicated instance. One customer, no control plane.
#           This is the default and the shape the app has always had.
#   multi   Shared SaaS plane. Tenants are resolved per request from the Host
#           header via the control plane. Start the stack with the `saas`
#           profile as well:  docker compose --profile saas up -d --build
#
TENANCY_MODE=single

# Single-tenant identity (ignored when TENANCY_MODE=multi).
DEFAULT_TENANT_ID=default
DEFAULT_TENANT_NAME=EquiMed

# Host suffix for tenant subdomains on the SaaS plane, e.g. acme.equimed.app.
BASE_DOMAIN=equimed.app

# --- ERPNext image ---
# This project targets ERPNext v16; v15 is a known-good default that is
# guaranteed to have a published image tag. Set to v16 once verified.
ERPNEXT_VERSION=v15

# --- ERPNext site ---
SITE_NAME=equimed.local
ADMIN_PASSWORD=admin

# --- MariaDB ---
DB_ROOT_PASSWORD=admin

# --- FastAPI auth / JWT ---
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
# Initial administrator, seeded on first backend startup.
# Only used when TENANCY_MODE=single — on the SaaS plane each workspace's first
# administrator is created by the control plane during provisioning.
FIRST_ADMIN_EMAIL=admin@equimed.cm
FIRST_ADMIN_PASSWORD=admin12345
FIRST_ADMIN_NAME=Administrator

# Encrypts tenant-held third-party credentials at rest in the *tenant app*
# (mobile-money API keys). Derived from JWT_SECRET_KEY when unset so a dev
# install works; set it explicitly in production, because rotating the JWT
# secret would otherwise make every stored credential unreadable.
#   Generate with:  openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# --- FastAPI <-> ERPNext API credentials ---
# Generate in ERPNext:  User > Settings > API Access > Generate Keys
# On the SaaS plane these are per-tenant and live in the control-plane
# registry; the values below are the single-tenant / fallback pair.
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# ============================================================================
# Control plane (TENANCY_MODE=multi only — `saas` compose profile)
# ============================================================================
# Shared secret for machine-to-machine calls in BOTH directions:
#   control plane -> tenant app    POST /internal/tenants/{id}/bootstrap
#   tenant app    -> control plane GET  /internal/tenants/resolve
# Both services must agree. Left unset, both refuse every internal call.
#   Generate with:  openssl rand -hex 32
INTERNAL_API_TOKEN=

# The control plane signs operator sessions with its OWN key. Never reuse
# JWT_SECRET_KEY here: a tenant token must not be valid on the control plane.
#   Generate with:  openssl rand -hex 32
PLATFORM_JWT_SECRET_KEY=CHANGE_ME_PLATFORM_SECRET

# Note: SECRET_ENCRYPTION_KEY (declared above) is read by BOTH services — the
# tenant app seals mobile-money credentials with it, the control plane seals
# tenant ERPNext credentials. One value, two databases.

# First platform operator, seeded on first control-plane startup.
FIRST_OWNER_EMAIL=owner@equimed.app
FIRST_OWNER_PASSWORD=changeme12345
FIRST_OWNER_NAME=Platform Owner

# Operator console hostname (served by Caddy, separate from every tenant host).
PLATFORM_DOMAIN=console.equimed.app

# Which reverse-proxy config Caddy mounts:
#   Caddyfile        single-tenant, plain HTTP on :80 (default)
#   Caddyfile.saas   SaaS plane: console host, tenant hosts, on-demand TLS
CADDYFILE=Caddyfile

# Provisioning backend:
#   noop   record intent only — safe default; provision ERPNext sites by hand
#   bench  shell out to the Frappe bench to create/drop sites. Requires the
#          Docker socket mounted into platform-api, which is a real privilege
#          escalation risk — read docs/multi-tenancy.md before enabling.
PROVISIONER=noop

# --- Ports ---
HTTP_PORT=80        # Caddy public entry point
HTTPS_PORT=443      # Caddy TLS (needed for real domains / on-demand TLS)
ERPNEXT_PORT=8080   # direct access to ERPNext admin UI (dev only — the
                    # production overlay unpublishes this)

# ============================================================================
# Production
# ============================================================================
# Uncomment to load the production overlay automatically, so `docker compose
# up -d` cannot accidentally run development defaults. Requires Compose v2.24+
# (the overlay uses the `!override` merge tag).
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
#
# The overlay makes these FATAL if unset — compose refuses to start rather
# than booting on a weak default:
#   DB_ROOT_PASSWORD, JWT_SECRET_KEY, SECRET_ENCRYPTION_KEY,
#   FIRST_ADMIN_PASSWORD, CORS_ORIGINS
#   ...and on the SaaS plane: PLATFORM_JWT_SECRET_KEY, INTERNAL_API_TOKEN,
#   FIRST_OWNER_PASSWORD, PLATFORM_CORS_ORIGINS
#
# Lock CORS to your real origins — '["*"]' with credentials allowed is a
# development convenience, not a production setting.
# CORS_ORIGINS=["https://erp.example.com"]
# PLATFORM_CORS_ORIGINS=["https://console.example.com"]

# Memory ceilings. Defaults suit a 4 GB VM; raise on a larger host.
# DB_MEM_LIMIT=1500m
# DB_BUFFER_POOL=512M
# ERPNEXT_MEM_LIMIT=1500m
# BACKEND_MEM_LIMIT=512m
# FRONTEND_MEM_LIMIT=512m
# PLATFORM_MEM_LIMIT=384m
# PLATFORM_UI_MEM_LIMIT=384m
